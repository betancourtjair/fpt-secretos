# ---------------------------------------------------------------
# FPT Secretos — variables de entorno
# Copia este archivo como .env y llena los valores.
# ---------------------------------------------------------------

# Puerto local (Render lo inyecta automaticamente en produccion)
PORT=3000

# URL publica de la aplicacion. Se usa para construir los enlaces.
# Ej. https://secretos.fpt.com.mx
PUBLIC_BASE_URL=http://localhost:3000

# Cadena de conexion de PostgreSQL (Neon).
# Ej. postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Pimienta del servidor: 32+ bytes aleatorios en base64.
# Se mezcla en la derivacion de llaves para que la base de datos por si sola
# no sea suficiente para descifrar. GENERALA UNA SOLA VEZ y NO la cambies:
# si la cambias, todos los secretos existentes quedan ilegibles.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_PEPPER=

# Limites operativos
MAX_SECRET_BYTES=100000
MAX_TTL_HOURS=168

# Archivos adjuntos. Se guardan cifrados en la base de datos, asi que subir
# estos numeros consume almacenamiento de Neon y RAM del servicio: con el plan
# Free de Render (512 MB) no conviene pasar de 5 MB.
MAX_FILES=5
MAX_FILES_BYTES=5242880

# ---------------------------------------------------------------
# Notificaciones por correo (Microsoft Graph, opcional)
# Si dejas estas variables vacias, la app funciona igual pero sin avisos.
# Requiere un App Registration en Entra ID con permiso de aplicacion
# Mail.Send y consentimiento de administrador.
# ---------------------------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Buzon remitente (UPN o id del usuario) desde el que salen los avisos
GRAPH_SENDER=notificaciones@fpt.com.mx

# Cada cuantos minutos corre la limpieza de secretos vencidos
CLEANUP_INTERVAL_MINUTES=5
